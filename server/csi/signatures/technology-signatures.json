    {
        "name": "React",
        "type": "framework",
        "regex": "<div[^>]+id=[\"']root[\"'][^>]*>",
        "versionRegex": "react@([0-9\\.]+)"
    },
    {
        "name": "jQuery",
        "type": "framework",
        "regex": "jquery[-.]([0-9\\.]+)\\.min\\.js"
    }
]
