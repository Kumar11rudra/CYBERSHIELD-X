[
    {
        "name": "WordPress",
        "type": "cms",
        "regex": "<meta\\s+name=[\"']generator[\"']\\s+content=[\"']WordPress\\s+([0-9\\.]+)[\"']"
    },
    {
        "name": "Drupal",
        "type": "cms",
        "regex": "<meta\\s+name=[\"']Generator[\"']\\s+content=[\"']Drupal\\s+([0-9]+)\\s"
